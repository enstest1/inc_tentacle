# Only genuinely public values belong in NEXT_PUBLIC_*.
# Never put PRIVATE_KEY, SEED_PHRASE, or DEPLOYER_SECRET here.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=763373

NEXT_PUBLIC_INK_RPC_URL=https://rpc-gel.inkonchain.com
NEXT_PUBLIC_INK_RPC_FALLBACK_URL=https://rpc-qnd.inkonchain.com
NEXT_PUBLIC_INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com
NEXT_PUBLIC_INK_SEPOLIA_RPC_FALLBACK_URL=https://rpc-qnd-sepolia.inkonchain.com

# One Tentacle deployment per (chain, token). Fill after a verified deploy.
NEXT_PUBLIC_TENTACLE_MAINNET_USDC_ADDRESS=
NEXT_PUBLIC_TENTACLE_MAINNET_USDCE_ADDRESS=
NEXT_PUBLIC_TENTACLE_SEPOLIA_MOCK_ADDRESS=

# Token allowlist. Native USDC is Circle-issued; USDC.e is bridged.
NEXT_PUBLIC_INK_USDC_ADDRESS=0x2D270e6886d130D724215A266106e6832161EAEd
NEXT_PUBLIC_INK_USDCE_ADDRESS=0xF1815bd50389c46847f0Bda824eC8da914045D14
NEXT_PUBLIC_INK_SEPOLIA_MOCK_USDC_ADDRESS=

